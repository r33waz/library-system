# ================================
# Use Node 23 Alpine as base image
# Lightweight Node image, good for development
# ================================
FROM node:23-alpine AS dev

# Set working directory inside container
WORKDIR /app

# Copy package.json and package-lock.json to install dependencies
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Install development tools globally (not recommended in prod)
RUN npm install -g nodemon ts-node typescript

# Copy all backend source code
COPY . .

# Expose port 8000 (backend API)
EXPOSE 8000

# Start backend in development mode with hot-reloading
# nodemon watches for changes in .ts and .json files
CMD ["nodemon", "--watch", ".", "--ext", "ts,json", "--exec", "ts-node", "src/server.ts"]
